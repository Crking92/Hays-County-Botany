  "morphology_keys": {
    "life_cycle": "Annual or biennial.",
    "habit": "Widely branching spiny herb to roughly 0.8 m; stems prickly throughout.",
    "foliage": "Leaves deeply lobed; lower surface sparingly to copiously prickly on and sometimes between veins; upper surface less prickly.",
    "latex": "Orange to reddish-orange when fresh.",
    "flower": "Large white flower, roughly 8–12 cm broad; numerous stamens.",
    "bud_sepals": "Bud body about 18–25 × 14–18 mm; sepal horns angular or flattened, about 8–12 mm, prickly.",
    "capsule": "Ovoid, about 40–50 × 15–25 mm excluding prickles; prickles very unequal, often branched, with the longest commonly 15–35 mm.",
    "flowering": "Spring through summer; fruiting summer through fall."
  },
  "field_diagnostics": {
    "single_best_trait": "Orange to reddish-orange latex.",
    "high_value_traits": [
      "orange/reddish-orange latex",
