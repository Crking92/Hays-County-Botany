  "field_diagnostics": {
    "single_best_trait": "For I. nil versus I. hederacea, compare sepal architecture before leaf shape: nil sepals are long, densely hairy basally and narrow gradually toward a mostly straighter distal portion, with a usually larger flower.",
    "fastest_traits": [
      "Annual twining vine",
      "Corolla usually 30–60+ mm in FNA",
      "Sepals 15–25(–30) mm",
      "Sepals densely hispid near the base and gradually narrowed distally",
      "Leaves cordate/orbiculate or 3-lobed; surfaces hairy"
    ],
    "look_alikes": [
      {
        "taxon": "Ipomoea hederacea",
        "distinction": "Lengths overlap, so use shape: I. hederacea sepals are broader basally then abruptly narrow into conspicuously curved/spreading tips; I. nil sepals narrow more gradually and are generally straighter. Nil also tends toward the larger corolla."
      },
      {
        "taxon": "Ipomoea lindheimeri",
        "distinction": "I. lindheimeri is perennial with a very large 55–90 mm flower, long 18–30 mm sepals and strongly lobed hairy foliage; use habit and flower/sepal scale."
      }
    ],
    "unreliable_alone": [
      "three-lobed leaves",
      "blue/purple flower",
      "sepal length without shape"
    ]
  },
