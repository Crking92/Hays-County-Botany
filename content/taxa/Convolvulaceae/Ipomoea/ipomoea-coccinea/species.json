  "field_diagnostics": {
    "single_best_trait": "Do not stop at 'red morning glory.' Check the calyx and pedicels: the sepals carry corniform/awnlike terminal appendages, and mature pedicels are reflexed.",
    "fastest_traits": [
      "Red to red-yellow salverform corolla about 20–25 mm",
      "Outer sepals 3–3.5 mm and inner sepals 4.5–5.7 mm",
      "Corniform/awnlike terminal appendage on the sepals",
      "Pedicels reflexed in the key comparison with I. hederifolia",
      "Twining annual habit"
    ],
    "look_alikes": [
      {
        "taxon": "Ipomoea hederifolia",
        "distinction": "FNA separates I. coccinea by reflexed pedicels (erect in I. hederifolia) and larger inner sepals, 4.5–5.7 mm versus about 3–4 mm. Red flower color alone is not enough."
      }
    ],
    "unreliable_alone": [
      "red flower color",
      "general heart-shaped morning-glory leaf"
    ]
  },
